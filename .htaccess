# compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>
# caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Development backups and build scripts must never be served
<FilesMatch "(?i)(\.backup\.html|\.round3\.backup\.html|^check_site\.py$|^build\.py$|^site-facts\.json$)">
  Require all denied
</FilesMatch>

# consolidated: how-it-works duplicated gc3.html#how
Redirect 301 /how-it-works.html /gc3.html

Redirect 301 /gcc-vs-pod.html /compare.html

# assets are versioned with ?v=, so one year is safe and matches _headers
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

Redirect 301 /industries/education.html /industries.html

Redirect 301 /industries/healthcare.html /industries.html

Redirect 301 /industries/manufacturing.html /industries.html

Redirect 301 /industries/travel.html /industries.html
